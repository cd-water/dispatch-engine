<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.ridematching</groupId>
  <artifactId>ride-matching-engine</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Real-Time Ride-Matching Engine</name>
  <description>Event-driven ride dispatch backend</description>

  <!--
    特意不从 spring-boot-starter-parent 继承，而是改为在下方导入 BOM，
    这样这个构建就能拥有自己的插件配置，并且 domain
    模块可以完全摆脱任何 Spring 继承关系。参见 ADR-0001。
  -->

  <!--
    libs 逐个列出：它们没有共同的依赖集合（domain 甚至一个都没有），
    所以聚合器只会多出一个文件，却消不掉任何重复。
    services 确实共享一个，因此它们有自己的父 POM。
  -->
  <modules>
    <module>libs/domain</module>
    <module>libs/events</module>
    <module>libs/geoindex</module>
    <module>libs/platform</module>
    <module>libs/schema</module>
    <module>services</module>
  </modules>

  <properties>
    <!--
      构建与运行在 JDK 25（LTS）上，但字节码仍刻意以 21 为目标。
      升级的原因是 JEP 491（JDK 24），它移除了 synchronized 块上的虚拟线程
      钉扎（pinning）——这是 JVM 运行时行为，而非字节码特性。把 release 目标
      保持在 21，既获得全部收益，又不承担任何工具链风险：ArchUnit
      和其他字节码读取器永远不必解析 class 文件版本 69。
      把它提升到 25 是一个独立的决定，应根据语言特性本身的优劣来判断。
    -->
    <java.version>25</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spring-boot.version>4.1.1</spring-boot.version>
    <archunit.version>1.3.0</archunit.version>
    <!-- 与 spring-boot-dependencies 4.1.1 中的 testcontainers.version 属性保持一致。 -->
    <testcontainers.version>2.0.5</testcontainers.version>

    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.2</maven-failsafe-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!--
        固定为 spring-boot-dependencies 在其 testcontainers.version 属性中声明的
        精确版本。Boot 4 设置了该属性却没有导入 BOM，因此这个导入必须显式写出 ——
        同时仍然跟随 Boot 已测试过的版本，而不是独立挑选一个。
      -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- 内部模块：版本只声明一次，其余地方引用时不带版本号。 -->
      <dependency>
        <groupId>com.ridematching</groupId>
        <artifactId>domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ridematching</groupId>
        <artifactId>events</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ridematching</groupId>
        <artifactId>geoindex</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ridematching</groupId>
        <artifactId>platform</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ridematching</groupId>
        <artifactId>schema</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <compilerArgs>
              <!-- 在运行时保留参数名：Spring 和 Jackson 都依赖它们。 -->
              <arg>-parameters</arg>
              <arg>-Xlint:all</arg>
            </compilerArgs>
          </configuration>
        </plugin>

        <!-- 单元测试：*Test。速度快，不依赖任何基础设施。 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <includes>
              <include>**/*Test.java</include>
            </includes>
          </configuration>
        </plugin>

        <!-- 集成测试：*IT。由 Testcontainers 支撑，绑定到 verify 阶段。 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <configuration>
            <includes>
              <include>**/*IT.java</include>
            </includes>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
