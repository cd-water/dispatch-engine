                <artifactId>events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cdwater</groupId>
                <artifactId>geoindex</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cdwater</groupId>
                <artifactId>platform</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cdwater</groupId>
                <artifactId>schema</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

