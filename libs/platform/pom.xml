<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ridematching</groupId>
    <artifactId>ride-matching-engine</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>platform</artifactId>
  <name>platform</name>
  <description>Cross-cutting infrastructure config shared by every service: observability, defaults.</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- 发件箱（outbox）写入并发布 DomainEvent 实例。 -->
    <dependency>
      <groupId>com.ridematching</groupId>
      <artifactId>events</artifactId>
    </dependency>

    <!--
      与 Redis 客户端出于同样的原因设为可选：发件箱需要 JDBC 和 Kafka，但
      一个不保存任何持久化状态的服务，不应仅仅因为依赖了 platform 就继承
      一个 datasource。真正运行发件箱的 dispatch-api 和 trip-service 会自行
      声明这两者。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Jackson 3（tools.jackson），用于把事件载荷序列化进发件箱行。
         每个服务都已经通过 starter-web 拥有它；声明为可选，是为了让发件箱
         能在这里编译通过，同时避免 platform 把一套 JSON 技术栈拖进一个
         用不上它的服务里。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-json</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- 可选：ProcessedEvents 需要它，但一个没有 Kafka 消费者的服务不应
         仅仅因为依赖了 platform 就继承一个 Redis 客户端。消费者自行声明。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
