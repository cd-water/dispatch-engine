<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ridematching</groupId>
    <artifactId>ride-matching-engine</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>services</artifactId>
  <packaging>pom</packaging>
  <name>services</name>
  <description>Parent for deployable services: everything every service needs, declared once.</description>

  <modules>
    <module>dispatch-api</module>
    <module>location-service</module>
    <module>matching-engine</module>
    <module>trip-service</module>
    <module>notification-service</module>
    <module>billing-service</module>
  </modules>

  <!--
    由每个服务继承。服务之间不共享的内容应放进各自的 POM：
    location-service 里的 Lettuce、消费方中的 Spring Kafka、trip-service 里的 JPA。
    只有当六个服务都确实需要时才放到这里。
  -->
  <dependencies>
    <dependency>
      <groupId>com.ridematching</groupId>
      <artifactId>domain</artifactId>
    </dependency>
    <dependency>
      <groupId>com.ridematching</groupId>
      <artifactId>events</artifactId>
    </dependency>
    <!-- 它会随之引入 actuator、Prometheus 注册表以及共享的可观测性
         自动配置。 -->
    <dependency>
      <groupId>com.ridematching</groupId>
      <artifactId>platform</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 每个服务都是可执行 jar。在这里声明一次，而不是重复写六次。 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!--
            不带 classifier 时，repackage 会用 fat jar 替换普通 jar。Failsafe
            在 package 之后运行，于是集成测试会从一个把类放在 BOOT-INF/classes
            下的 jar 里解析类，进而抛出 NoClassDefFoundError。
            这个 classifier 让普通 jar 继续作为模块 artifact（其他模块和
            测试所编译的对象），并把可运行的那个发布为 *-exec.jar。
          -->
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
