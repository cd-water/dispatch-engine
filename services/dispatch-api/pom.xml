<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ridematching</groupId>
    <artifactId>services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>dispatch-api</artifactId>
  <name>dispatch-api</name>
  <description>Ride request intake: REST API, idempotency, hand-off to Kafka.</description>

  <!-- 公共依赖和 Spring Boot 的 repackage goal 都继承自
       services/pom.xml。这里只添加本服务特有的内容。 -->
  <dependencies>
    <!-- 通过 JdbcClient 使用原生 SQL 而非 JPA：幂等性保证取决于
         INSERT ... ON CONFLICT DO NOTHING 的精确语义，而 ORM 会把它隐藏掉。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- 用的是 STARTER，而不是裸 spring-kafka。Boot 4 把自动配置拆分成了
         按技术划分的模块，所以仅有这个库不会激活任何东西 —— 悄无声息，
         与 Phase 4 中的 flyway-core 一模一样。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Boot 4 把自动配置拆分成了按技术划分的模块：classpath 上只有 flyway-core
         已不足以激活它，因此需要显式声明 spring-boot-flyway。
         缺了它 Flyway 根本不会运行，悄无声息 —— 没有报错，也没有日志行。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <!-- 迁移脚本本身放在共享的 schema 模块里：有两个服务会写这些表，
         所以谁都不该单独拥有这些 DDL。 -->
    <dependency>
      <groupId>com.ridematching</groupId>
      <artifactId>schema</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 对异步排空做轮询需要真正的 await，而不是 Thread.sleep。 -->
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
