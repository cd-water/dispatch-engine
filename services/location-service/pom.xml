<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ridematching</groupId>
    <artifactId>services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>location-service</artifactId>
  <name>location-service</name>
  <description>WebSocket GPS ingestion into the Redis geospatial index.</description>

  <!-- 公共依赖和 Spring Boot 的 repackage goal 都继承自
       services/pom.xml。这里只添加本服务特有的内容。 -->
  <dependencies>
    <!-- 引入 Redis 键布局、索引端口及其适配器。 -->
    <dependency>
      <groupId>com.ridematching</groupId>
      <artifactId>geoindex</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <!-- 在 Testcontainers 2.x 中由 "junit-jupiter" 更名而来。 -->
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
